# Copy to .env and fill in real values. Never commit .env to git.
NODE_ENV=production
PORT=3000

DB_HOST=your-vps-host
DB_PORT=5432
DB_NAME=portfolio_blog
DB_USER=your-db-user
DB_PASSWORD=CHANGE_ME
DB_SSL_MODE=disable
# Production: set DB_SSL_MODE=require and configure PostgreSQL SSL.

DATABASE_URL=postgres://your-db-user:CHANGE_ME@your-vps-host:5432/portfolio_blog

JWT_SECRET=changeme-jwt-secret-min-32-chars-long-here
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=CHANGE_ME_bcrypt_hash_from_bcryptjs

CORS_ORIGIN=https://your-domain.example
